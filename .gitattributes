# Keep text files normalized to LF across macOS, Linux, and Windows
* text=auto eol=lf

# Collapse generated bundles in GitHub PR diffs
js/atlas_snapshots.js linguist-generated=true
js/atlas_boot.js linguist-generated=true
js/snapshots/*.js linguist-generated=true
js/event_pinyin.js linguist-generated=true

# Auto-resolve ?v= / data-v-* cache-busting hash conflicts in index.html
index.html merge=sync-version
